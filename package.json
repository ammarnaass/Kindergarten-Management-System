{
  "name": "rawdati",
  "version": "0.1.0",
  "description": "نظام إدارة روضة أطفال لسطح المكتب - روضتي",
  "main": "out/main/index.js",
  "author": "Rawdati",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "dist": "npm run build && electron-builder --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "dist:all": "npm run build && electron-builder --publish never",
    "install:core": "npm install --no-audit --no-fund --no-save electron electron-vite vite @vitejs/plugin-react typescript",
    "install:app": "npm install --no-audit --no-fund --no-save react react-dom react-router-dom @tanstack/react-query zustand zod drizzle-orm better-sqlite3 electron-log @electron-toolkit/utils i18next react-i18next react-hook-form @hookform/resolvers"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^3.0.0",
    "@hookform/resolvers": "^3.9.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@react-pdf/renderer": "^3.4.4",
    "@tanstack/react-query": "^5.59.0",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.36.4",
    "drizzle-zod": "^0.5.1",
    "electron-log": "^5.1.4",
    "electron-updater": "^6.3.0",
    "exceljs": "^4.4.0",
    "i18next": "^23.16.0",
    "lucide-react": "^1.58.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "react-i18next": "^15.1.0",
    "react-router-dom": "^6.27.0",
    "tailwind-merge": "^3.7.0",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.1",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.7.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.27.2",
    "electron": "40.10.2",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.1.0",
    "eslint": "^9.12.0",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.2"
  }
}
